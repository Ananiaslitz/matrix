{
    "name": "ananiaslitz/matrix",
    "type": "library",
    "license": "MIT",
    "description": "A multi-tenant library for Hyperf APIs.",
    "keywords": [
        "hyperf",
        "multi-tenant",
        "swoole",
        "coroutine"
    ],
    "authors": [
        {
            "name": "Diego Ananias",
            "email": "diegohsananias@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "hyperf/database": "^3.0",
        "hyperf/di": "^3.0",
        "hyperf/command": "^3.0",
        "hyperf/db-connection": "^3.0",
        "hyperf/context": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Ananiaslitz\\Matrix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ananiaslitz\\Matrix\\Tests\\": "tests/"
        }
    },
    "extra": {
        "hyperf": {
            "config": "Ananiaslitz\\Matrix\\ConfigProvider"
        }
    }
}